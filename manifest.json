        "productivity",
        "lifestyle",
        "utilities",
        "business",
        "personalization"
    ],
    "lang": "en",
    "dir": "ltr",
    "scope": "/",
    "prefer_related_applications": false,
    "related_applications": [],
    "display_override": [
        "standalone",
        "fullscreen",
        "minimal-ui"
    ],
    "edge_side_panel": {
        "preferred_width": 400
    },
    "protocol_handlers": [
        {
            "protocol": "web+lifeos",
            "url": "/protocol-handler?command=%s"
        }
    ],
    "share_target": {
        "action": "/share-target",
        "method": "POST",
        "enctype": "multipart/form-data",
        "params": {
            "title": "title",
            "text": "text",
            "url": "url",
            "files": [
                {
                    "name": "file",
                    "accept": ["image/*", "text/*", "application/pdf"]
                }
            ]
        }
    },
    "launch_handler": {
        "client_mode": "focus-existing"
    },
    "file_handlers": [
        {
            "action": "/import",
            "accept": {
                "text/csv": [".csv"],
                "application/json": [".json"],
                "text/plain": [".txt"]
            }
        }
    ],
    "note_taking": {
        "new_note_url": "/notes/new"
    }
}